# Smart PDF Generator — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
ALLOWED_ORIGIN=http://localhost:3000

# Optional: PDF Storage cleanup (in minutes, default: 60)
PDF_CLEANUP_INTERVAL=60

# Optional: Max upload size (in MB, default: 5)
MAX_UPLOAD_SIZE=5
